{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flowey.dev/schemas/hierarchy.schema.json",
  "title": "Flowey hierarchy diagram",
  "description": "Top-down parent/child tree: org charts, reporting lines, dotted-line relationships, advisory links. Geometry is fully derived; authors describe people (or units) and who reports to whom.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "nodes"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "hierarchy" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "output"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "translations": { "$ref": "common.schema.json#/$defs/translations" },
        "subtitle": { "type": "string" },
        "output": { "$ref": "common.schema.json#/$defs/portableOutputPath" },
        "animation": { "$ref": "common.schema.json#/$defs/animation" },
        "visual_preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "views": { "$ref": "common.schema.json#/$defs/guidedViews" },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "entries": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "actor": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "action": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "decision": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "milestone": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "place": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "document": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "record": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "outcome": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "group": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "external": { "$ref": "common.schema.json#/$defs/legendEntry" }
              }
            }
          }
        },
        "viewBox": {
          "description": "Optional minimum canvas. The tree is always laid out top-down from measured labels; an authored viewBox smaller than the computed tree fails validation instead of squeezing text.",
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 320 },
            { "type": "number", "minimum": 240 }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "type": { "$ref": "common.schema.json#/$defs/componentType" },
          "label": { "type": "string", "minLength": 1 },
          "role": {
            "description": "Job title or function shown under the name, e.g. Dean, Registrar, Class monitor.",
            "type": "string",
            "minLength": 1
          },
          "tag": { "type": "string", "minLength": 1 },
          "icon": { "$ref": "common.schema.json#/$defs/nodeIcon" },
          "brand": { "$ref": "common.schema.json#/$defs/brandMark" },
          "citations": { "$ref": "common.schema.json#/$defs/citations" },
          "width": { "type": "number", "minimum": 96 }
        }
      }
    },
    "links": {
      "description": "Parent/child reporting lines. Each non-root node has exactly one parent link; variant dashed draws a dotted-line (advisory) relationship.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parent", "child"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "parent": { "$ref": "common.schema.json#/$defs/id" },
          "child": { "$ref": "common.schema.json#/$defs/id" },
          "label": { "type": "string", "minLength": 1 },
          "variant": { "$ref": "common.schema.json#/$defs/variant" },
          "width": { "$ref": "common.schema.json#/$defs/relationshipWidth" }
        }
      }
    },
    "cards": { "$ref": "common.schema.json#/$defs/cards" }
  }
}
