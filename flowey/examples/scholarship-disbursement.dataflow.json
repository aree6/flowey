    {
      "id": "award_letter",
      "type": "document",
      "label": "Award letter",
      "sublabel": "signed offer",
      "stage": 2,
      "row": 3
    },
    {
      "id": "bursary",
      "type": "place",
      "label": "Bursary",
      "sublabel": "payments office",
      "stage": 3,
      "row": 1
    },
    {
      "id": "bank",
      "type": "external",
      "label": "Student bank",
      "sublabel": "direct credit",
      "stage": 3,
      "row": 3
    }
