  "flows": [
    {
      "id": "application",
      "from": "student",
      "to": "portal",
      "label": "application",
      "variant": "emphasis",
      "labelAt": [
        100,
        315
      ]
    },
    {
      "id": "enrolment_check",
      "from": "portal",
      "to": "records",
      "label": "enrolment pull",
      "variant": "default"
    },
    {
      "id": "income_check",
      "from": "portal",
