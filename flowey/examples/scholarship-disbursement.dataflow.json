    {
      "id": "portal",
      "type": "action",
      "label": "Aid portal",
      "sublabel": "online form",
      "stage": 0,
      "row": 3
    },
    {
      "id": "records",
      "type": "record",
      "label": "Student records",
      "sublabel": "enrolment + grades",
      "stage": 1,
      "row": 0
