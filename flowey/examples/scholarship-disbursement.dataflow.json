      "variant": "default",
      "labelAt": [
        330,
        429
      ]
    },
    {
      "id": "eligible",
      "from": "means_test",
      "to": "committee",
      "label": "eligible file",
      "variant": "emphasis"
    },
    {
      "id": "award",
      "from": "committee",
      "to": "award_letter",
      "label": "award decision",
      "variant": "emphasis",
      "labelAt": [
        530,
        315
      ]
    },
    {
      "id": "accept",
      "from": "award_letter",
      "to": "bursary",
      "label": "accepted offer",
      "variant": "default"
    },
    {
      "id": "payout",
      "from": "bursary",
      "to": "bank",
      "label": "semester payout",
      "classification": "restricted",
      "variant": "alert",
      "labelAt": [
        745,
        315
      ]
    }
  ],
  "cards": [
    {
      "dot": "amber",
      "title": "Money path",
      "items": [
        "Eligibility gates the committee; the committee gates the payout",
        "The final bank transfer is the only restricted flow"
      ]
    }
