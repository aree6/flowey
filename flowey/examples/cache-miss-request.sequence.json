  "activations": [
    { "participant": "web", "from": 180, "to": 474, "type": "actor" },
    { "participant": "api", "from": 185, "to": 450, "type": "action" },
    { "participant": "auth", "from": 205, "to": 244, "type": "decision" },
    { "participant": "redis", "from": 265, "to": 304, "type": "document" },
    { "participant": "db", "from": 325, "to": 364, "type": "document" },
    { "participant": "trace", "from": 413, "to": 449, "type": "record" }
